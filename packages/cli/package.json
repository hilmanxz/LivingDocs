{
  "name": "@livingdocs/cli",
  "version": "0.1.0",
  "description": "CLI interface for LivingDocs",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "livingdocs": "./bin/livingdocs.js"
  },
  "scripts": {
    "build": "tsup src/index.ts --format esm --dts",
    "dev": "tsup src/index.ts --format esm --dts --watch",
    "test": "vitest",
    "lint": "eslint src"
  },
  "keywords": [
    "documentation",
    "ai",
    "codebase",
    "architecture",
    "living-docs"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@livingdocs/shared": "workspace:*",
    "@livingdocs/core": "workspace:*",
    "@livingdocs/engine": "workspace:*",
    "commander": "^12.1.0"
  },
  "devDependencies": {
    "tsup": "^8.0.1"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
