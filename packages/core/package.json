{
  "name": "@livingdocs/core",
  "version": "0.1.0",
  "description": "Core analysis engine for LivingDocs",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "scripts": {
    "build": "tsup src/index.ts --format esm --dts",
    "dev": "tsup src/index.ts --format esm --dts --watch",
    "test": "vitest",
    "lint": "eslint src"
  },
  "dependencies": {
    "@livingdocs/shared": "workspace:*",
    "typescript": "^5.3.3",
    "@typescript-eslint/typescript-estree": "^6.13.0"
  },
  "devDependencies": {
    "tsup": "^8.0.1",
    "tree-sitter-typescript": "^0.21.2",
    "@types/node": "^20.10.0"
  }
}
