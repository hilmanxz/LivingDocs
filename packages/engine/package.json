{
  "name": "@livingdocs/engine",
  "version": "0.1.0",
  "description": "Documentation generation engine for LivingDocs",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "scripts": {
    "build": "tsup src/index.ts --format esm --dts",
    "dev": "tsup src/index.ts --format esm --dts --watch",
    "test": "vitest",
    "lint": "eslint src"
  },
  "dependencies": {
    "@livingdocs/shared": "workspace:*",
    "@livingdocs/core": "workspace:*"
  },
  "devDependencies": {
    "tsup": "^8.0.1"
  }
}
